{
  "name": "@nictool/dns-nameserver",
  "version": "0.10.0",
  "description": "DNS Nameserver",
  "main": "index.js",
  "bin": {
    "nt-powerdns": "bin/nt-powerdns.js"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"for (const p of ['node_modules','coverage']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "format": "npm run prettier:fix && npm run lint:fix",
    "lint": "npx eslint index.js lib test",
    "lint:fix": "npx eslint --fix index.js lib test",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write --log-level=warn",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:coverage:lcov": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "versions": "npx npm-dep-mgr check",
    "versions:fix": "npx npm-dep-mgr update"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/NicTool/dns-nameserver.git"
  },
  "keywords": [
    "dns",
    "server",
    "import",
    "nictool"
  ],
  "author": "Matt Simerson <matt@tnpi.net>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/NicTool/dns-nameserver/issues"
  },
  "homepage": "https://github.com/NicTool/dns-nameserver#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  },
  "dependencies": {
    "@nictool/dns-resource-record": "^1.8.2",
    "@nictool/dns-zone": "^1.2.4",
    "chalk": "^6.0.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "dns2": "^3.1.1",
    "mysql2": "^3.23.2",
    "smol-toml": "^1.7.1"
  },
  "prettier": {
    "printWidth": 90,
    "singleQuote": true,
    "semi": false
  }
}
